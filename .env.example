# ==============================================================================
# Sewa Setu Assistant — Environment Configuration Template
# Copy to .env or export into your shell / compose environment
# ==============================================================================

# Administrator Password for Portal Web UI
ADMIN_PASSWORD=dev

# Flask Web Session & Crypto Secret
SECRET_KEY=dev-secret-key-change-in-production

# OAuth 2.1 JWT Secret for Token Issuance & Verification
JWT_SECRET=dev-jwt-secret-purvanchal-2026

# Internal Service Shared Key (Portal <-> MCP Servers)
INTERNAL_SERVICE_KEY=dev-internal-key-change-me

# PostgreSQL Database Configuration
PORTAL_DB_HOST=localhost
PORTAL_DB_PORT=5432
PORTAL_DB_NAME=sewasetu
PORTAL_DB_USER=sewasetu
PORTAL_DB_PASSWORD=sewasetu

# SMS Gateway Service Endpoint
SMS_GATEWAY_URL=http://localhost:8025

# Scheme Deadline Override (Format: YYYY-MM-DD HH:MM)
SCHEME_DEADLINE=2026-12-31 23:59

# Pilot Blocks Enabled for AI Agents (Comma-separated)
AGENT_ENABLED_BLOCKS=Sonari,Rajapara,Dhemaji Pathar,Borgaon,Namti,Khelua

# MCP Server Endpoints
PORTAL_INTERNAL_URL=http://localhost:8000/internal/v1
PORTAL_PUBLIC_URL=http://localhost:8000
CITIZEN_MCP_PORT=8001
OFFICER_MCP_PORT=8002
